rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // >>> Put the Google account(s) allowed to run the presenter screen here <<<
    function isPresenter() {
      return request.auth != null
        && request.auth.token.email in ['khotsohec55@gmail.com'];
    }

    function game() {
      return get(/databases/$(database)/documents/game/state).data;
    }

    function validAlloc(a) {
      return a is map
        && a.keys().hasAll(['saEq', 'saBond', 'saProp', 'saCash', 'glEq', 'glBond', 'gold'])
        && a.keys().hasOnly(['saEq', 'saBond', 'saProp', 'saCash', 'glEq', 'glBond', 'gold'])
        && a.saEq is int && a.saBond is int && a.saProp is int && a.saCash is int
        && a.glEq is int && a.glBond is int && a.gold is int
        && a.saEq >= 0 && a.saBond >= 0 && a.saProp >= 0 && a.saCash >= 0
        && a.glEq >= 0 && a.glBond >= 0 && a.gold >= 0
        && a.saEq + a.saBond + a.saProp + a.saCash + a.glEq + a.glBond + a.gold == 100;
    }

    function validEntry(d) {
      return d.keys().hasOnly(['name', 'alloc', 'submittedAt'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 20
        && d.submittedAt == request.time
        && validAlloc(d.alloc);
    }

    // ---------------- Classroom game ----------------

    // Game state: everyone signed in (learners sign in anonymously) can read,
    // only the presenter can change it.
    match /game/state {
      allow read: if request.auth != null;
      allow write: if isPresenter();
    }

    // One entry per learner per round. Learners can only write their own,
    // only while submissions are open for that round.
    match /rounds/{roundId}/entries/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && game().phase == 'open'
        && game().roundId == roundId
        && validEntry(request.resource.data);
      allow delete: if isPresenter();
    }

    // ---------------- Online competition ----------------

    function compOpen() {
      return get(/databases/$(database)/documents/competition/config).data.open == true;
    }

    function validCompEntry(d) {
      return d.keys().hasAll(['name', 'email', 'phone', 'under18', 'consent', 'alloc1', 'alloc2', 'submittedAt'])
        && d.keys().hasOnly(['name', 'email', 'phone', 'under18', 'consent', 'alloc1', 'alloc2', 'submittedAt', 'guardianName', 'guardianConsent'])
        && d.name is string && d.name.size() >= 2 && d.name.size() <= 60
        && d.email is string && d.email.size() <= 120 && d.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && d.phone is string && d.phone.size() >= 9 && d.phone.size() <= 20
        && d.under18 is bool
        && d.consent == true
        && d.submittedAt == request.time
        && validAlloc(d.alloc1) && validAlloc(d.alloc2)
        && (d.under18 == false
            || (d.guardianName is string && d.guardianName.size() >= 2 && d.guardianName.size() <= 60
                && d.guardianConsent == true));
    }

    // Open/closed switch: readable by anyone signed in, changed only by the organiser.
    match /competition/config {
      allow read: if request.auth != null;
      allow write: if isPresenter();
    }

    // The returns: private to the organiser.
    match /competition/secret {
      allow read, write: if isPresenter();
    }

    // One entry per device. Entrants can create their entry once (no edits) and read only
    // their own; only the organiser can see or delete everyone's.
    match /compEntries/{uid} {
      allow create: if request.auth != null
        && request.auth.uid == uid
        && compOpen()
        && validCompEntry(request.resource.data);
      allow read: if isPresenter() || (request.auth != null && request.auth.uid == uid);
      allow update: if false;
      allow delete: if isPresenter();
    }
  }
}
